# Server
HOST=0.0.0.0
PORT=1337
# Public URL of the app (set automatically on Railway via ${{RAILWAY_PUBLIC_DOMAIN}})
URL=
IS_PROXIED=true

# Secrets — generate each with: openssl rand -base64 32
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database — sqlite locally, postgres on Railway
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=false

# Optional: Cloudinary media uploads (local filesystem is used when unset)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

STRAPI_TELEMETRY_DISABLED=true
